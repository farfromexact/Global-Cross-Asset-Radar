{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/farfromexact/Global-Cross-Asset-Radar/schemas/report.schema.json",
  "title": "Global Cross-Asset Radar Report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "edition"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_published",
        "published",
        "archive_failed"
      ]
    },
    "report_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "edition": {
      "type": "string",
      "enum": [
        "morning",
        "evening",
        "commodities_morning",
        "commodities_evening"
      ]
    },
    "generated_at_bjt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "weekend_mode": {
      "type": "boolean"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "one_sentence_conclusion": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "regime": {
      "type": [
        "string",
        "null"
      ]
    },
    "worth_taking_risk": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "data_cutoff": {
      "type": "object",
      "additionalProperties": true
    },
    "input_snapshots": {
      "type": "object",
      "properties": {
        "china_options_repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "china_options_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "china_options_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "china_options_generated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "china_options_fresh": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "china_options_official_coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "china_commodities": {
          "type": "object",
          "required": [
            "repository",
            "branch",
            "last_run_status_path",
            "radar_latest_path",
            "radar_history_path",
            "trade_date",
            "generated_at",
            "data_fresh",
            "official_complete",
            "source_date_match_pct",
            "full_market_ready",
            "critical_module_errors",
            "history_record_count",
            "module_quality",
            "actual_read_paths"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "const": "farfromexact/China-Commodities-Engine"
            },
            "branch": {
              "type": "string",
              "const": "main"
            },
            "last_run_status_path": {
              "type": "string",
              "const": "data/last_run_status.json"
            },
            "radar_latest_path": {
              "type": "string",
              "const": "data/radar_latest.json"
            },
            "radar_history_path": {
              "type": "string",
              "const": "data/radar_history.json"
            },
            "trade_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "generated_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "data_fresh": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "official_complete": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "source_date_match_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "full_market_ready": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "critical_module_errors": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "history_record_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "module_quality": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "included_exchanges": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "actual_read_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "source_status": {
      "type": "object",
      "additionalProperties": true
    },
    "dashboard": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset"
        ],
        "properties": {
          "asset": {
            "type": "string"
          },
          "latest": {},
          "change_1d": {},
          "change_1w": {},
          "signal": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_attribute": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "meaningful_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "top_opportunities": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "name",
          "score"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "direction": {
            "type": [
              "string",
              "null"
            ]
          },
          "holding_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "instruments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_loss_limited": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "score_components": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "top_trade_cards": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "gold_tracking": {
      "type": "object",
      "additionalProperties": true
    },
    "ai_tracking": {
      "type": "object",
      "additionalProperties": true
    },
    "china_tracking": {
      "type": "object",
      "properties": {
        "qualified_trade": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "preferred_future": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "IH",
            "IF",
            "IC",
            "IM",
            null
          ]
        },
        "futures_option_linkage": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "commodities_tracking": {
      "type": "object",
      "required": [
        "data_quality",
        "market_dashboard",
        "supply_chain_map",
        "options_surface",
        "night_session_risk_map"
      ],
      "properties": {
        "data_quality": {
          "type": "object",
          "required": [
            "status",
            "price_source",
            "curve_definition",
            "basis_status",
            "warehouse_status",
            "member_rankings_status",
            "options_chain_status",
            "options_surface_status",
            "history_comparison_status",
            "available_horizons",
            "comparative_metrics"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "degraded",
                "stale_or_partial"
              ]
            },
            "price_source": {
              "type": "string"
            },
            "curve_definition": {
              "type": "string",
              "const": "near_minus_next_futures_curve_not_spot_basis"
            },
            "basis_status": {
              "type": "string"
            },
            "warehouse_status": {
              "type": "string"
            },
            "member_rankings_status": {
              "type": "string"
            },
            "options_chain_status": {
              "type": "string"
            },
            "options_surface_status": {
              "type": "string"
            },
            "history_comparison_status": {
              "type": "string",
              "enum": [
                "available",
                "insufficient_history",
                "stale_or_partial"
              ]
            },
            "available_horizons": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "1D",
                  "3D",
                  "5D",
                  "20D"
                ]
              },
              "uniqueItems": true
            },
            "comparative_metrics": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "history_comparison_status": {
                    "const": "insufficient_history"
                  }
                },
                "required": [
                  "history_comparison_status"
                ]
              },
              "then": {
                "properties": {
                  "available_horizons": {
                    "maxItems": 0
                  },
                  "comparative_metrics": {
                    "maxItems": 0
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        },
        "market_dashboard": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "product",
              "main_contract"
            ],
            "properties": {
              "product": {
                "type": "string"
              },
              "main_contract": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "supply_chain_map": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "options_surface": {
          "type": "object",
          "required": [
            "status",
            "available_metrics",
            "tradeable_structures",
            "research_priority_when_ready"
          ],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "ready",
                "not_ready",
                "not_collected",
                "unavailable"
              ]
            },
            "available_metrics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tradeable_structures": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "research_priority_when_ready": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "not": {
                      "const": "ready"
                    }
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "available_metrics": {
                    "maxItems": 0
                  },
                  "tradeable_structures": {
                    "maxItems": 0
                  }
                }
              }
            }
          ],
          "additionalProperties": true
        },
        "night_session_risk_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "product",
              "confidence",
              "action"
            ],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "event_calendar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "action_list": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "properties": {
        "A": {
          "type": "string"
        },
        "B": {
          "type": "string"
        },
        "C": {
          "type": "string"
        },
        "D": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "risk_budget": {
      "type": "object",
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "source_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed_at_bjt": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "supported_claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "archive": {
      "type": "object",
      "properties": {
        "markdown_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "json_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_markdown_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "latest_json_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "archive_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pending",
            "success",
            "partial",
            "failed",
            null
          ]
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "required": [
          "report_date",
          "generated_at_bjt",
          "title",
          "one_sentence_conclusion",
          "regime",
          "worth_taking_risk",
          "input_snapshots",
          "source_status",
          "dashboard",
          "meaningful_changes",
          "top_opportunities",
          "top_trade_cards",
          "gold_tracking",
          "ai_tracking",
          "china_tracking",
          "event_calendar",
          "action_list",
          "risk_budget",
          "sources",
          "archive"
        ]
      }
    }
    ,
    {
      "if": {
        "properties": {
          "edition": {
            "enum": [
              "commodities_morning",
              "commodities_evening"
            ]
          },
          "status": {
            "const": "published"
          }
        },
        "required": [
          "edition",
          "status"
        ]
      },
      "then": {
        "required": [
          "commodities_tracking"
        ],
        "properties": {
          "input_snapshots": {
            "required": [
              "china_commodities"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
